{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Master",
  "type": "object",
  "required": [
    "schema_version",
    "document",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "document": {
      "type": "object",
      "required": [
        "brand",
        "product_name",
        "master_version",
        "status"
      ]
    },
    "facts": {
      "type": "array"
    }
  }
}
